	.c_b		{color:black}
	.c_s		{color:#afafaf}
	.c_sb		{color:darkgray}
	.c_bl		{color:blue}
	.ta_c		{text-align:center;}
	.ta_l		{text-align:left;}
	.ta_r		{text-align:right;}
	.bc_g		{background-color:#efefef}
	.bc_1		{background-color:#FFE6E6}
	.bc_0		{background-color:#FFE6E6}
	.bc_sk		{background-color:#EDE6DE}
	.bd_l		{border-left:2px solid black}


	br { mso-data-placement:same-cell; }
	td.txt {mso-number-format:\@}
	td.dt {mso-number-format:yyyy-mm-dd hh:mm:ss}
	td.num {mso-number-format:\#\,\#\#}
</style>


