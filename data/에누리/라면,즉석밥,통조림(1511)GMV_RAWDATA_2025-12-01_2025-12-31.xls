	table.rowset	{border-collapse:collapse;}
	table.rowset td {padding:2 3 2 2;}
	table.rowset thead {height:30;font-weight:bold;font-size:14;}
	table.rowset caption {padding:10;text-align:center;font-weight:bold;font-size:14;}

	ol			{margin:5 25;}
	ul			{margin:5 1;}

	.ff_vdn		{font-family: arial}
	.ff_tah		{font-family: tahoma}
	.ff_ari		{font-family: arial}
