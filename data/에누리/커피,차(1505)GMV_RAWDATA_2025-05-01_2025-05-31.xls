	th {font-size:9pt;background-color:#eaeaea;height:25;padding:2;}
	table.rowset	{border-collapse:collapse;}
	table.rowset td {padding:2 3 2 2;}
	table.rowset thead {height:30;font-weight:bold;font-size:14;}
	table.rowset caption {padding:10;text-align:center;font-weight:bold;font-size:14;}

	ol			{margin:5 25;}
	ul			{margin:5 1;}

	.ff_vdn		{font-family: arial}
	.ff_tah		{font-family: tahoma}
	.ff_ari		{font-family: arial}
	.fs_8		{font-size:8pt}
	.fs_9		{font-size:9pt}
	.fs_10		{font-size:10pt}
	.fs_11		{font-size:11pt}
	.fw_b		{font-weight:bold}
	.c_b		{color:black}
	.c_s		{color:#afafaf}
	.c_sb		{color:darkgray}
	.c_bl		{color:blue}
	.ta_c		{text-align:center;}
	.ta_l		{text-align:left;}
	.ta_r		{text-align:right;}
	.bc_g		{background-color:#efefef}
	.bc_1		{background-color:#FFE6E6}
	.bc_0		{background-color:#FFE6E6}
	.bc_sk		{background-color:#EDE6DE}
	.bd_l		{border-left:2px solid black}


	br { mso-data-placement:same-cell; }
	td.txt {mso-number-format:\@}
	td.dt {mso-number-format:yyyy-mm-dd hh:mm:ss}
	td.num {mso-number-format:\#\,\#\#}
</style>


