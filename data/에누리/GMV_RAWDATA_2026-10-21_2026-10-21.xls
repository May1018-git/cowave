	.bc_sk		{background-color:#EDE6DE}
	.bd_l		{border-left:2px solid black}


	br { mso-data-placement:same-cell; }
	td.txt {mso-number-format:\@}
	td.dt {mso-number-format:yyyy-mm-dd hh:mm:ss}
	td.num {mso-number-format:\#\,\#\#}
</style>


